<instance format="XCSP3" type="CSP">
    <variables>
        <var id="x"> 0 1 </var>
        <var id="y"> 0 1 </var>
        <var id="z"> 0 1 </var>
        <var id="w"> 0 1 </var>
        <var id="a"> 0 1 </var>
        <var id="b"> 0 1 </var>
        <var id="c"> 0 1 </var>
        <var id="d"> 0 1 </var>
        <var id="p"> 0..2 </var>
        <var id="q"> 0..2 </var>
    </variables>
    <constraints>
        <knapsack>
            <list> x y </list>
            <weights> 1 2 </weights>
            <condition> (eq,1) </condition>
            <profits> 1 1 </profits>
            <condition> (eq,1) </condition>
        </knapsack>
        <knapsack>
            <list> z w </list>
            <weights> 1 2 </weights>
            <condition> (eq,1) </condition>
            <profits> 1 1 </profits>
            <condition> (eq,1) </condition>
        </knapsack>
        <knapsack>
            <list> a b </list>
            <weights> 1 2 </weights>
            <condition> (ge,1) </condition>
            <profits> 1 1 </profits>
            <condition> (eq,p) </condition>
        </knapsack>
        <knapsack>
            <list> c d </list>
            <weights> 1 2 </weights>
            <condition> (ge,1) </condition>
            <profits> 1 1 </profits>
            <condition> (eq,q) </condition>
        </knapsack>
    </constraints>
</instance>

<instance format="XCSP3" type="CSP">
    <variables>
        <var id="x"> 0..3 </var>
        <var id="y"> 0..3 </var>
        <var id="z"> 0..3 </var>
    </variables>
    <constraints>
        <extension>
            <list> x </list>
            <supports> 0 1 1 2 </supports>
        </extension>
        <group>
            <extension>
                <list> %0 %1 %2 </list>
                <supports> (0,*,1)(0,2,*)(1,1,1)(1,1,1)(2,*,*)(2,3,0) </supports>
            </extension>
            <args> x y z </args>
            <args> z y x </args>
        </group>
    </constraints>
</instance>

+// True if the list has both an integer entry and one that is not.
+static bool isMixedList(vector<XVariable *> &list) {
+    bool anyInteger = false, anyOther = false;
+    int v;
+    for(XEntity *xe: list) {
+        if(isInteger(xe, v))
+            anyInteger = true;
+        else
+            anyOther = true;
+    }
+    return anyInteger && anyOther;
+}
